# Liga a camada de mocks (MSW REST + Socket.IO). O build de demonstração usa true.
VITE_ENABLE_MOCKS=true
# Base da API REST (com mocks, o MSW responde em /api)
VITE_API_URL=/api
# Servidor Socket.IO (com mocks, o MSW intercepta este endereço)
VITE_SOCKET_URL=wss://realtime.kurio.mock

# --- Servidor: só a Vercel Function api/send-reset-email usa (nunca vão para o navegador) ---
# Configure no painel da Vercel (Settings → Environment Variables). Não ponha valores aqui nem no .env
# (versionado). Sem BREVO_API_KEY e BREVO_SENDER_EMAIL o envio real fica desligado e vale só o e-mail simulado.
# Chave da API do Brevo (segredo)
BREVO_API_KEY=
# Remetente verificado no Brevo
BREVO_SENDER_EMAIL=
# Nome do remetente (padrão: Kurio)
BREVO_SENDER_NAME=
# Endereço público do app; só links dele são aceitos (padrão: host da própria requisição)
PUBLIC_APP_URL=
